---
import { authors } from '../data/site';

interface Props {
  authorId: keyof typeof authors;
}

const { authorId } = Astro.props;
const author = authors[authorId];

if (!author) {
  throw new Error(`Unknown author: ${authorId}`);
}

const website = 'website' in author.links ? author.links.website : undefined;
const primaryLink = author.links.github ?? website;
---

{
  primaryLink ? (
    <a
      href={primaryLink}
      class="author-badge"
      target="_blank"
      rel="noreferrer"
      aria-label={`Open ${author.name} profile`}
    >
      <img class="author-avatar" src={author.avatar} alt="" loading="lazy" />
      <span>{author.name}</span>
    </a>
  ) : (
    <span class="author-badge">
      <img class="author-avatar" src={author.avatar} alt="" loading="lazy" />
      <span>{author.name}</span>
    </span>
  )
}

<style>
  .author-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1.8px solid var(--outline);
    background: var(--panel);
    padding: 0.22rem 0.62rem 0.22rem 0.22rem;
    color: var(--text);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  a.author-badge:hover {
    background: var(--line);
    transform: translateY(-1px);
  }

  .author-avatar {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
