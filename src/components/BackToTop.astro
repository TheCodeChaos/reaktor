<button class="back-to-top" id="back-to-top" type="button" aria-label="Back to top" data-pagefind-ignore>
  ↑
</button>

<script>
  const button = document.getElementById('back-to-top');
  const idleDelay = 2000;
  let idleTimer: number | undefined;

  const syncBackToTop = () => {
    if (!button) return;
    window.clearTimeout(idleTimer);
    button.classList.toggle('visible', window.scrollY > 420);
    // Fade out again once scrolling settles, so it is not parked on screen.
    idleTimer = window.setTimeout(
      () => button.classList.remove('visible'),
      idleDelay
    );
  };

  button?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Don't fade out from under a cursor that is on its way to the button.
  button?.addEventListener('pointerenter', () => window.clearTimeout(idleTimer));
  button?.addEventListener('pointerleave', syncBackToTop);

  window.addEventListener('scroll', syncBackToTop, { passive: true });
</script>

<style>
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 46px;
    height: 46px;
    border: var(--border-thick) solid var(--outline);
    border-radius: var(--radius-sm);
    background: var(--panel);
    box-shadow: var(--lift-sm) var(--lift-sm) 0 var(--shadow);
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
    z-index: 35;
  }

  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .back-to-top:hover {
    background: var(--accent);
    color: var(--on-accent);
    color: var(--on-primary);
  }
</style>
