---
interface FAQItem {
  question: string;
  body: readonly string[];
}

interface Props {
  items: readonly FAQItem[];
}

const { items } = Astro.props;
---

<div class="faq-list" data-reveal>
  {
    items.map(item => (
      <div class="faq-item">
        <h3>{item.question}</h3>
        {item.body.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    ))
  }
</div>

<style>
  .faq-list {
    display: grid;
    gap: 1.9rem;
  }

  .faq-item h3 {
    margin: 0 0 0.4rem;
    font-weight: 650;
    font-size: 1.06rem;
    letter-spacing: -0.01em;
  }

  .faq-item p {
    margin: 0;
    color: var(--text-muted);
    max-width: 68ch;
  }

  .faq-item p + p {
    margin-top: 0.7rem;
  }
</style>
