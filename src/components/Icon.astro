export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const icon: IconDef = icons[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? undefined : 'currentColor'}
  stroke-width={icon.filled ? undefined : 1.7}
  stroke-linecap={icon.filled ? undefined : 'round'}
  stroke-linejoin={icon.filled ? undefined : 'round'}
  aria-hidden="true"
  set:html={icon.body}
/>
