---
import { Search, X } from '@lucide/astro';
import PagefindSearch from './PagefindSearch.astro';
---

<div class="search-modal" id="search-modal" aria-hidden="true" data-pagefind-ignore>
  <button class="search-modal-backdrop" type="button" data-close-search aria-label="Close search"></button>
  <div
    class="search-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-modal-title"
  >
    <div class="search-modal-top">
      <p class="search-modal-eyebrow" id="search-modal-title">
        <Search size={16} /> Search
      </p>
      <button class="search-modal-close" type="button" data-close-search aria-label="Close search">
        <X size={18} />
      </button>
    </div>

    <PagefindSearch label="Search Reaktor" idPrefix="pagefind-modal" />
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const body = document.body;

  function getSearchQuery() {
    const value = new URL(window.location.href).searchParams.get('q');
    return value ? value.trim() : '';
  }

  function applySearchQuery(value: string) {
    const input = modal?.querySelector('.pagefind-ui__search-input');

    if (!(input instanceof HTMLInputElement)) {
      return false;
    }

    input.value = value;
    input.dispatchEvent(new Event('input', { bubbles: true }));
    return true;
  }

  function openModal() {
    if (!modal) {
      return;
    }

    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('open');
    body.style.overflow = 'hidden';

    window.setTimeout(() => {
      const input = modal.querySelector('.pagefind-ui__search-input');
      if (input && 'focus' in input && typeof input.focus === 'function') {
        input.focus();
      }
    }, 40);
  }

  function openModalWithQuery(value: string) {
    openModal();

    if (!value) {
      return;
    }

    if (applySearchQuery(value)) {
      return;
    }

    let attempts = 0;
    const retryTimer = window.setInterval(() => {
      attempts += 1;
      if (applySearchQuery(value) || attempts >= 40) {
        window.clearInterval(retryTimer);
      }
    }, 60);
  }

  function closeModal() {
    if (!modal) {
      return;
    }

    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('open');
    body.style.overflow = '';
  }

  const initialQuery = getSearchQuery();
  if (initialQuery) {
    openModalWithQuery(initialQuery);
  }

  document.querySelectorAll('[data-open-search]').forEach(trigger => {
    trigger.addEventListener('click', event => {
      event.preventDefault();
      openModal();
    });
  });

  modal?.querySelectorAll('[data-close-search]').forEach(trigger => {
    trigger.addEventListener('click', closeModal);
  });

  window.addEventListener('reaktor:open-search', () => {
    openModalWithQuery(getSearchQuery());
  });

  window.addEventListener('popstate', () => {
    const query = getSearchQuery();
    if (query) {
      openModalWithQuery(query);
    }
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && modal?.classList.contains('open')) {
      closeModal();
    }

    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openModal();
    }
  });
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: none;
  }

  .search-modal.open {
    display: grid;
    place-items: start center;
  }

  .search-modal-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    margin: 0;
    background: rgba(19, 19, 24, 0.5);
    cursor: pointer;
  }

  .search-modal-dialog {
    position: relative;
    width: min(820px, calc(100% - 2rem));
    margin-top: clamp(4.5rem, 8vh, 6.5rem);
    border-radius: var(--radius-lg);
    background: var(--panel);
    padding: 0.95rem;
    box-shadow: 0 22px 44px rgba(29, 29, 36, 0.16);
  }

  .search-modal-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.7rem;
  }

  .search-modal-eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-soft);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-modal-close {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-dim);
    color: var(--text);
    cursor: pointer;
  }

  .search-modal :global(.search-shell) {
    padding: 0.15rem;
    background: transparent;
  }

  .search-modal :global(.search-header) {
    display: none;
  }

  .search-modal :global(.pagefind-ui) {
    margin-top: 0;
  }

  .search-modal :global(.pagefind-ui__drawer) {
    max-height: min(60vh, 500px);
    overflow: auto;
    margin-top: 1.1rem;
    padding: 0 0.25rem;
  }

  @media (max-width: 700px) {
    .search-modal-dialog {
      width: calc(100% - 1rem);
      margin-top: calc(var(--nav-height) + 0.5rem);
      padding: 0.75rem;
      border-radius: var(--radius-md);
    }
  }
</style>
