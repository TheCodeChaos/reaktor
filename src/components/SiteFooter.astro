---
import Icon from './Icon.astro';
import { navLinks, siteConfig } from '../data/site';
---

<footer class="site-footer section" data-pagefind-ignore>
  <div class="container footer-wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <img
          class="footer-logo"
          src={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/\//g, '/')}
          alt=""
          aria-hidden="true"
        />
        <h2>Built for tense chain reactions and comeback turns.</h2>
      </div>

      <div class="footer-links">
        <div>
          <h3>Explore</h3>
          {
            navLinks.map(link => (
              <a href={`${import.meta.env.BASE_URL}${link.href}`.replace(/\/\//g, '/')}>
                {link.label}
              </a>
            ))
          }
        </div>

        <div>
          <h3>Project</h3>
          <a href={siteConfig.issuesUrl} target="_blank" rel="noreferrer">
            Report issue
          </a>
          <a href={`${import.meta.env.BASE_URL}/rss.xml`.replace(/\/\//g, '/')}>
            <Icon name="rss" size={16} /> RSS
          </a>
          <button type="button" class="footer-search" data-open-search>
            <Icon name="search" size={16} /> Search
          </button>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Reaktor</span>
      <a href={`${import.meta.env.BASE_URL}/privacy`.replace(/\/\//g, '/')}>Privacy</a>
    </div>
  </div>
</footer>

<style>
  .footer-wrap {
    padding-top: 1.6rem;
  }

  .footer-top {
    display: grid;
    gap: 2rem;
    border-radius: var(--radius-lg);
    border: var(--border-thick) solid var(--outline);
    background: var(--panel);
    box-shadow: var(--lift) var(--lift) 0 var(--shadow);
    padding: 1.4rem;
  }

  .footer-logo {
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 0.9rem;
  }

  .footer-brand h2 {
    margin: 0 0 0.7rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 4vw, 2.35rem);
    line-height: 1.08;
  }

  .footer-brand p {
    margin: 0;
    max-width: 52ch;
    color: var(--text-muted);
  }

  .footer-links {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .footer-links h3 {
    margin: 0 0 0.65rem;
    color: var(--text);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  .footer-links a,
  .footer-links p {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.52rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-search {
    margin: 0 0 0.52rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    cursor: pointer;
  }

  .footer-links strong {
    color: var(--text);
    margin-right: 0.22rem;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-search:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.15rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .footer-bottom a:hover {
    color: var(--text);
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 720px) {
    .footer-top {
      padding: 1.1rem;
    }

    .footer-brand,
    .footer-links,
    .footer-bottom {
      text-align: center;
    }

    .footer-brand p {
      margin-inline: auto;
    }

    .footer-logo {
      display: block;
      margin-inline: auto;
    }

    .footer-links {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .footer-links a,
    .footer-links p,
    .footer-search {
      justify-content: center;
    }

    .footer-bottom {
      justify-content: center;
    }
  }
</style>
