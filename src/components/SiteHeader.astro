---
import Icon from './Icon.astro';
import { navLinks, playLink, siteConfig } from '../data/site';
import SearchModal from './SearchModal.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const normalizedHref = href === '/' ? '/' : href.replace(/\/$/, '');
  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}
---

<header class="site-header" data-pagefind-ignore>
  <div class="container header-inner">
    <a href={`${import.meta.env.BASE_URL}/`.replace(/\/\//g, '/')} class="brand-link">
      <img
        class="brand-logo"
        src={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/\//g, '/')}
        alt=""
        aria-hidden="true"
      />
      <span class="brand-copy">
        <strong>{siteConfig.shortName}</strong>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navLinks.map(link => (
          <a
            href={`${import.meta.env.BASE_URL}${link.href}`.replace(/\/\//g, '/')}
            class:list={['nav-link', { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button class="search-link" type="button" data-open-search aria-label="Search the site">
        <Icon name="search" size={16} /> Search
      </button>
      <a href={playLink.href} class="play-link" target="_blank" rel="noreferrer">
        Play
      </a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme">
        <Icon name="sun" size={17} class="sun-icon" />
        <Icon name="moon" size={17} class="moon-icon" />
      </button>
      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-controls="mobile-panel"
        aria-expanded="false"
      >
        <Icon name="menu" size={19} class="menu-open" />
        <Icon name="close" size={19} class="menu-close" />
      </button>
    </div>
  </div>

  <div class="container mobile-drawer" id="mobile-panel">
    <div class="mobile-card">
      <div class="mobile-panel-head">
        <p class="mobile-panel-title">Menu</p>
        <button class="mobile-search" type="button" data-open-search>
          <Icon name="search" size={15} /> Search
        </button>
      </div>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        {
          navLinks.map(link => (
            <a
              href={`${import.meta.env.BASE_URL}${link.href}`.replace(/\/\//g, '/')}
              class:list={['mobile-link', { active: isActive(link.href) }]}
            >
              {link.label}
            </a>
          ))
        }
        <a href={playLink.href} class="mobile-play" target="_blank" rel="noreferrer">
          Play game
        </a>
      </nav>
    </div>
  </div>

  <SearchModal />
</header>

<script>
  const root = document.documentElement;
  const menuToggle = document.getElementById('menu-toggle');
  const mobilePanel = document.getElementById('mobile-panel');
  const themeToggle = document.getElementById('theme-toggle');

  const setTheme = (theme: string) => {
    root.dataset.theme = theme;
    localStorage.setItem('reaktor-theme', theme);
  };

  themeToggle?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
    setTheme(nextTheme);
  });

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobilePanel?.classList.toggle('open');
    menuToggle.classList.toggle('active', Boolean(isOpen));
    menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  document.querySelectorAll('.mobile-link, .mobile-search').forEach(link => {
    link.addEventListener('click', () => {
      mobilePanel?.classList.remove('open');
      menuToggle?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  const header = document.querySelector('.site-header');
  let lastY = window.scrollY;

  const syncHeader = () => {
    if (!header) return;
    const y = window.scrollY;
    // Stay put while the drawer is open, and never hide at the very top where
    // rubber-band scrolling would flicker it.
    if (mobilePanel?.classList.contains('open') || y < 80) {
      header.classList.remove('hidden');
      lastY = y;
      return;
    }
    if (Math.abs(y - lastY) > 6) {
      header.classList.toggle('hidden', y > lastY);
      lastY = y;
    }
  };

  window.addEventListener('scroll', syncHeader, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    background: transparent;
    transition: transform 0.3s ease;
  }

  .site-header.hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--nav-height);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: var(--border) solid var(--outline);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    pointer-events: none;
  }

  .header-inner {
    position: relative;
    z-index: 1;
    min-height: var(--nav-height);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.2rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.58rem;
  }

  .brand-logo {
    width: 1.78rem;
    height: 1.78rem;
    border-radius: 8px;
    flex: 0 0 auto;
  }

  .brand-copy {
    display: inline-flex;
    align-items: center;
    line-height: 1.05;
  }

  .brand-copy strong {
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: 1.02rem;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .nav-link {
    border: var(--border) solid transparent;
    color: var(--text-muted);
    padding: 0.35rem 0.62rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    border-color: var(--outline);
    background: var(--panel);
    color: var(--text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
  }

  .search-link,
  .play-link,
  .theme-toggle,
  .menu-toggle {
    border: var(--border) solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    min-height: 39px;
  }

  .search-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.82rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .search-link:hover {
    border-color: var(--outline);
    color: var(--text);
    background: var(--panel);
  }

  .play-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1.1rem;
    color: var(--on-primary);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    background: var(--accent);
    color: var(--on-accent);
    border: var(--border-thick) solid var(--outline);
    border-radius: var(--radius-sm);
    box-shadow: var(--lift-sm) var(--lift-sm) 0 var(--shadow);
    transition:
      transform 0.09s ease,
      box-shadow 0.09s ease;
  }

  .play-link:active {
    transform: translate(var(--lift-sm), var(--lift-sm));
    box-shadow: 0 0 0 var(--shadow);
  }

  .play-link:hover {
    opacity: 0.88;
  }

  .theme-toggle,
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 39px;
    padding: 0;
    cursor: pointer;
    color: var(--text-muted);
  }

  .theme-toggle:hover,
  .menu-toggle:hover {
    border-color: var(--outline);
    background: var(--panel);
    color: var(--text);
  }

  :global(.moon-icon),
  :global(.menu-close) {
    display: none;
  }

  :global([data-theme='light']) :global(.moon-icon) {
    display: block;
  }

  :global([data-theme='light']) :global(.sun-icon) {
    display: none;
  }

  .menu-toggle.active :global(.menu-open) {
    display: none;
  }

  .menu-toggle.active :global(.menu-close) {
    display: block;
  }

  .menu-toggle,
  .mobile-drawer {
    display: none;
  }

  .mobile-drawer {
    position: relative;
    z-index: 1;
    padding: 0.55rem 0 0.92rem;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-card {
    width: fit-content;
    margin-left: auto;
    max-width: min(92vw, 338px);
    height: fit-content;
    border-radius: var(--radius-md);
    border: var(--border-thick) solid var(--outline);
    background: var(--panel);
    box-shadow: var(--lift) var(--lift) 0 var(--shadow);
    padding: 0.7rem;
  }

  .mobile-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .mobile-panel-title {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mobile-search {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: var(--border) solid var(--outline);
    border-radius: var(--radius-sm);
    background: var(--panel);
    color: var(--text-muted);
    padding: 0.35rem 0.72rem;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .mobile-search:hover {
    color: var(--text);
  }

  .mobile-nav {
    display: grid;
    gap: 0.35rem;
    width: fit-content;
  }

  .mobile-link {
    display: block;
    padding: 0.58rem 0.62rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    border: var(--border) solid transparent;
    text-align: left;
    background: transparent;
    width: auto;
    font: inherit;
    cursor: pointer;
  }

  .mobile-link.active,
  .mobile-link:hover {
    border-color: var(--outline);
    color: var(--text);
    background: var(--panel);
  }

  .mobile-play {
    display: block;
    padding: 0.58rem 0.9rem;
    border-radius: 10px;
    color: var(--on-primary);
    font-weight: 600;
    font-size: 0.92rem;
    text-align: left;
    background: var(--accent);
    color: var(--on-accent);
    border: var(--border-thick) solid var(--outline);
    box-shadow: var(--lift-sm) var(--lift-sm) 0 var(--shadow);
    margin-top: 0.35rem;
  }

  @media (max-width: 1080px) {
    .desktop-nav {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .search-link {
      display: none;
    }

    .play-link {
      padding: 0.45rem 0.72rem;
      letter-spacing: 0.03em;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .header-actions {
      gap: 0.4rem;
    }
  }

  @media (max-width: 580px) {
    .brand-copy strong {
      font-size: 0.95rem;
    }
  }
</style>
