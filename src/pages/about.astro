---
import { Globe, Heart } from '@lucide/astro';
import BackToTop from '../components/BackToTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { builtWith, developers, featureCards } from '../data/site';
---

<Layout title="About" description="What Reaktor is and who builds it.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container about-page" data-pagefind-body>
      <section class="section about-hero" data-reveal>
        <h1 class="page-title">
          Chain reactions,
          <span class="gradient-text">made readable.</span>
        </h1>
        <p class="lede">A strategy game for 2 to 6 players around one screen.</p>
      </section>

      <section class="section pillars" data-reveal>
        <div class="pillars-grid section-tight">
          {
            featureCards.map(feature => (
              <article class="pillar">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section team" data-reveal>
        <h2 class="section-title">Team</h2>
        <div class="team-grid section-tight">
          {
            developers.map(dev => (
              <article class="team-card">
                <img src={dev.avatar} alt={dev.name} class="team-avatar" loading="lazy" />
                <h3>{dev.name}</h3>
                <div class="team-links">
                  <a
                    href={dev.links.github}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${dev.name} on GitHub`}
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
                    </svg>
                  </a>
                  {dev.links.linkedin && (
                    <a
                      href={dev.links.linkedin}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`${dev.name} on LinkedIn`}
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
                      </svg>
                    </a>
                  )}
                  {dev.links.website && (
                    <a
                      href={dev.links.website}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`${dev.name}'s website`}
                    >
                      <Globe size={18} />
                    </a>
                  )}
                  {dev.links.sponsor && (
                    <a
                      href={dev.links.sponsor}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`Sponsor ${dev.name}`}
                    >
                      <Heart size={18} />
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section built-with" data-reveal>
        <h2 class="section-title">Built with</h2>
        <p>{builtWith.join(' · ')}</p>
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .about-page {
    display: grid;
    gap: 0;
  }

  .about-hero {
    display: grid;
    gap: 0.95rem;
  }

  .pillars {
    padding-top: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .pillar {
    border-radius: var(--radius-md);
    padding: 1.25rem;
    background: var(--panel);
  }

  .pillar h3 {
    margin: 0 0 0.35rem;
    font-weight: 700;
    font-size: 1.08rem;
  }

  .pillar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .team {
    display: grid;
    gap: 0.4rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .team-card {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    border-radius: var(--radius-md);
    padding: 1.6rem 1.25rem;
    background: var(--panel);
    text-align: center;
  }

  .team-avatar {
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .team-card h3 {
    margin: 0;
    font-weight: 700;
    font-size: 1.15rem;
  }

  .team-links {
    display: flex;
    gap: 0.45rem;
  }

  .team-links a {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--surface-dim);
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .team-links a:hover {
    color: var(--text);
  }

  .built-with {
    display: grid;
    gap: 0.6rem;
  }

  .built-with p {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .pillars-grid,
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pillars-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
