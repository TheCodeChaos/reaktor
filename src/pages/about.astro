---
import Icon from '../components/Icon.astro';
import BackToTop from '../components/BackToTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { builtWith, developers, featureCards } from '../data/site';
---

<Layout title="About" description="What Reaktor is and who builds it.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container about-page" data-pagefind-body>
      <section class="section about-hero" data-reveal>
        <h1 class="page-title">
          Chain reactions,
          <span class="gradient-text">made readable.</span>
        </h1>
        <p class="lede">A strategy game for 1 to 6 players, against the computer or around one screen.</p>
      </section>

      <section class="section pillars" data-reveal>
        <div class="pillars-grid section-tight">
          {
            featureCards.map(feature => (
              <article class="pillar">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section team" data-reveal>
        <h2 class="section-title">Team</h2>
        <div class="team-grid section-tight">
          {
            developers.map(dev => (
              <article class="team-card">
                <img src={dev.avatar} alt={dev.name} class="team-avatar" loading="lazy" />
                <h3>{dev.name}</h3>
                <div class="team-links">
                  <a
                    href={dev.links.github}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${dev.name} on GitHub`}
                  >
                    <Icon name="github" size={18} />
                  </a>
                  {dev.links.linkedin && (
                    <a
                      href={dev.links.linkedin}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`${dev.name} on LinkedIn`}
                    >
                      <Icon name="linkedin" size={18} />
                    </a>
                  )}
                  {dev.links.website && (
                    <a
                      href={dev.links.website}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`${dev.name}'s website`}
                    >
                      <Icon name="globe" size={18} />
                    </a>
                  )}
                  {dev.links.sponsor && (
                    <a
                      href={dev.links.sponsor}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`Sponsor ${dev.name}`}
                    >
                      <Icon name="heart" size={18} />
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section built-with" data-reveal>
        <h2 class="section-title">Built with</h2>
        <p>{builtWith.join(' · ')}</p>
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .about-page {
    display: grid;
    gap: 0;
  }

  .about-hero {
    display: grid;
    gap: 0.95rem;
  }

  .pillars {
    padding-top: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .pillar {
    border-radius: var(--radius-md);
    border: var(--border) solid var(--outline);
    padding: 1.25rem;
    background: var(--panel);
  }

  .pillar h3 {
    margin: 0 0 0.35rem;
    font-weight: 700;
    font-size: 1.08rem;
  }

  .pillar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .team {
    display: grid;
    gap: 0.4rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .team-card {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    border-radius: var(--radius-md);
    border: var(--border-thick) solid var(--outline);
    padding: 1.6rem 1.25rem;
    background: var(--panel);
    box-shadow: var(--lift-sm) var(--lift-sm) 0 var(--shadow);
    text-align: center;
  }

  .team-avatar {
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    border: var(--border) solid var(--outline);
    object-fit: cover;
  }

  .team-card h3 {
    margin: 0;
    font-weight: 700;
    font-size: 1.15rem;
  }

  .team-links {
    display: flex;
    gap: 0.45rem;
  }

  .team-links a {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1.8px solid var(--outline);
    background: var(--panel);
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .team-links a:hover {
    color: var(--text);
  }

  .built-with {
    display: grid;
    gap: 0.6rem;
  }

  .built-with p {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .pillars-grid,
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pillars-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
