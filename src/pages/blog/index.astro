---
import { getCollection } from 'astro:content';
import BackToTop from '../../components/BackToTop.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog" description="Strategy notes, release thoughts, and setup guides for Reaktor.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container blog-page" data-pagefind-body>
      <section class="section blog-hero" data-reveal>
        <h1 class="page-title">Blog</h1>
        <p class="lede">Short, practical notes on playing better.</p>
      </section>

      <section class="section blog-list" data-reveal>
        {
          posts.map(post => (
            <a
              class="post-row"
              href={`${import.meta.env.BASE_URL}/blog/${post.id}/`.replace(/\/\//g, '/')}
            >
              <span class="post-meta">
                <FormattedDate date={post.data.pubDate} />
              </span>
              <span class="post-main">
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </span>
            </a>
          ))
        }
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .blog-page {
    display: grid;
    gap: 0;
  }

  .blog-hero {
    display: grid;
    gap: 0.95rem;
  }

  .blog-list {
    display: grid;
    gap: 0.5rem;
  }

  .post-row {
    display: grid;
    grid-template-columns: minmax(110px, 150px) 1fr;
    gap: 1.1rem;
    align-items: start;
    border-radius: var(--radius-md);
    padding: 1.1rem;
    transition: background 0.2s ease;
  }

  .post-row:hover {
    background: var(--panel);
  }

  .post-meta {
    padding-top: 0.24rem;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .post-main {
    display: grid;
    gap: 0.34rem;
    min-width: 0;
  }

  .post-title {
    font-weight: 650;
    letter-spacing: -0.01em;
    font-size: 1.24rem;
    line-height: 1.25;
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 0.99rem;
  }

  @media (max-width: 780px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .post-meta {
      padding-top: 0;
    }
  }
</style>
