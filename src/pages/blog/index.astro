---
import { getCollection } from 'astro:content';
import BackToTop from '../../components/BackToTop.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { authors } from '../../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog" description="Strategy notes, release thoughts, and setup guides for Reaktor.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container blog-page" data-pagefind-body>
      <section class="section blog-hero" data-reveal>
        <h1 class="page-title">Blog</h1>
        <p class="lede">Short, practical notes on playing better.</p>
      </section>

      <section class="section blog-list" data-reveal>
        {
          posts.map(post => (
            <a
              class="post-row"
              href={`${import.meta.env.BASE_URL}/blog/${post.id}/`.replace(/\/\//g, '/')}
            >
              <img
                class="post-cover"
                src={`${import.meta.env.BASE_URL}/og/blog/${post.id}.png`.replace(/\/\//g, '/')}
                alt=""
                width="1200"
                height="630"
                loading="lazy"
              />
              <span class="post-main">
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
                <span class="post-meta">
                  {
                    post.data.authors.map(id => {
                      const author = authors[id as keyof typeof authors];
                      return (
                        <span class="post-author">
                          <img class="post-avatar" src={author.avatar} alt="" loading="lazy" />
                          {author.name}
                        </span>
                      );
                    })
                  }
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </span>
            </a>
          ))
        }
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .blog-page {
    display: grid;
    gap: 0;
  }

  .blog-hero {
    display: grid;
    gap: 0.95rem;
  }

  .blog-list {
    display: grid;
    gap: 0.5rem;
  }

  .post-row {
    display: grid;
    grid-template-columns: 224px 1fr;
    gap: 1.4rem;
    align-items: center;
    border-radius: var(--radius-md);
    border: var(--border) solid transparent;
    padding: 1.1rem;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .post-row:hover {
    border-color: var(--outline);
    background: var(--panel);
  }

  .post-cover {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: var(--border) solid var(--outline);
  }

  .post-main {
    display: grid;
    gap: 0.34rem;
    min-width: 0;
  }

  .post-title {
    font-weight: 650;
    letter-spacing: -0.01em;
    font-size: 1.24rem;
    line-height: 1.25;
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 0.99rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.8rem;
    margin-top: 0.3rem;
    color: var(--text-soft);
    font-size: 0.88rem;
  }

  .post-author {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .post-avatar {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 780px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
