---
import BackToTop from '../components/BackToTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { credits } from '../data/site';
---

<Layout title="Credits" description="Libraries and tools behind Reaktor and its website.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container credits-page" data-pagefind-body>
      <section class="section credits-hero" data-reveal>
        <h1 class="page-title">Credits</h1>
        <p class="lede">The tools behind the game and this site.</p>
      </section>

      <section class="section credits-list" data-reveal>
        <div class="credit-groups">
        {
          credits.map((group, index) => (
            <article class="credit-group" style={`--group-index:${index};`}>
              <h2>{group.title}</h2>
              <ul>
                {group.items.map(item => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
        </div>
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .credits-page {
    display: grid;
    gap: 0;
  }

  .credits-list {
    display: grid;
    gap: 1rem;
  }

  .credit-groups {
    display: grid;
    gap: 0.95rem;
  }

  .credit-group {
    border-radius: var(--radius-md);
    padding: 1.25rem;
    background: var(--panel);
  }

  .credit-group h2 {
    margin: 0 0 0.7rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: clamp(1.3rem, 2.1vw, 1.6rem);
    line-height: 1.08;
  }

  .credit-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .credit-group li {
    border-radius: var(--radius-sm);
    padding: 0.62rem 0.72rem;
    background: var(--surface-dim);
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (min-width: 1020px) {
    .credit-groups {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1rem;
    }

    .credit-group {
      grid-column: span 6;
    }
  }
</style>
