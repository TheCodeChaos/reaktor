---
import { GitBranch, Globe } from '@lucide/astro';
import BackToTop from '../components/BackToTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { developers } from '../data/site';
---

<Layout title="Developers" description="Meet the people behind Reaktor.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container dev-page" data-pagefind-body>
      <section class="section dev-hero" data-reveal>
        <span class="eyebrow">Meet the devs</span>
        <h1 class="page-title">The people shaping each release.</h1>
        <p class="lede">
          Built and maintained together, from core gameplay logic to release polish.
        </p>
      </section>

      <section class="section-tight dev-showcase">
        {
          developers.map((dev, index) => {
            const website = dev.links.website;
            const githubHandle = dev.links.github?.split('/').filter(Boolean).pop();
            return (
              <article class="dev-card" data-reveal style={`--card-index:${index};`}>
                <div class="dev-core">
                  <div class="dev-avatar-wrapper">
                    {dev.avatar ? (
                      <img src={dev.avatar} alt={dev.name} class="dev-avatar" />
                    ) : (
                      <span class="dev-initials">{dev.initials}</span>
                    )}
                  </div>
                  <div>
                    <h2>{dev.name}</h2>
                    {githubHandle && <p class="dev-handle">@{githubHandle}</p>}
                  </div>
                </div>
                <div class="dev-links">
                  {dev.links.github && (
                    <a href={dev.links.github} target="_blank" rel="noreferrer">
                      <GitBranch size={16} /> GitHub
                    </a>
                  )}
                  {website && (
                    <a href={website} target="_blank" rel="noreferrer">
                      <Globe size={16} /> Website
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .dev-page {
    display: grid;
    gap: 0;
  }

  .dev-showcase {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .dev-showcase {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .dev-showcase {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .dev-card {
    display: grid;
    align-content: start;
    border-radius: var(--radius-md);
    padding: 1.5rem;
    background: var(--panel);
  }

  .dev-core {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: center;
    margin-bottom: 0.72rem;
  }

  .dev-avatar-wrapper {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--surface-dim);
  }

  .dev-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .dev-initials {
    display: inline-grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .dev-card:nth-child(4n + 1) .dev-initials {
    background: var(--player-red);
  }

  .dev-card:nth-child(4n + 2) .dev-initials {
    background: var(--player-blue);
  }

  .dev-card:nth-child(4n + 3) .dev-initials {
    background: var(--player-green);
  }

  .dev-card:nth-child(4n) .dev-initials {
    background: var(--player-yellow);
    color: #1d1d24;
  }

  .dev-card h2 {
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: 1.42rem;
    line-height: 1.06;
    color: var(--text);
  }

  .dev-handle {
    margin: 0.3rem 0 0;
    color: var(--text-soft);
    font-size: 0.84rem;
    letter-spacing: 0.07em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .dev-card p {
    margin: 0;
    color: var(--text-muted);
  }

  .dev-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.95rem;
    padding-top: 0.82rem;
    border-top: 1px solid var(--line-soft);
  }

  .dev-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    padding: 0.32rem 0.78rem;
    background: var(--surface-dim);
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .dev-links a:hover {
    color: var(--text);
  }
</style>
