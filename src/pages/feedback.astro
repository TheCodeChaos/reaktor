---
import BackToTop from '../components/BackToTop.astro';
import Giscus from '../components/Giscus.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Feedback" description="Share feedback and ideas for Reaktor.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container feedback-page" data-pagefind-body>
      <section class="section feedback-hero" data-reveal>
        <h1 class="page-title">Feedback</h1>
        <p class="lede">
          Ideas, impressions, or something that felt off? Leave a comment below. Sign in with
          GitHub to post.
        </p>
      </section>

      <section class="section" data-reveal>
        <Giscus />
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .feedback-page {
    display: grid;
    gap: 0;
  }

  .feedback-hero {
    display: grid;
    gap: 0.95rem;
  }
</style>
