---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import BackToTop from '../components/BackToTop.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { boardPresets, featureCards, playLink, siteConfig } from '../data/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const highlights = featureCards.slice(0, 3);
---

<Layout title={siteConfig.name} description={siteConfig.description}>
  <SiteHeader />

  <div class="page-shell">
    <main class="container home-page" data-pagefind-body>
      <section class="hero" data-reveal>
        <img
          class="hero-logo"
          src={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/\//g, '/')}
          alt=""
          aria-hidden="true"
        />
        <h1 class="display-title">
          Quick rounds,
          <span class="gradient-text">big reversals.</span>
        </h1>
        <p class="lede">A fast board game for friends. Tense until the last burst.</p>
        <div class="button-row">
          <a class="button button-play" href={playLink.href} target="_blank" rel="noreferrer">
            Play game
          </a>
          <a class="button" href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, '/')}>
            How to play
          </a>
        </div>
      </section>

      <section class="section highlight-stage" data-reveal>
        <div class="highlight-grid">
          {
            highlights.map(feature => (
              <article class="highlight">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section preset-stage" data-reveal>
        <h2 class="section-title">Three board sizes.</h2>
        <div class="preset-lane">
          {
            boardPresets.map(preset => (
              <article class="preset">
                <div class="preset-preview" aria-hidden="true">
                  <div class="preset-grid" style={`--cols:${preset.cols};`}>
                    {Array.from({ length: preset.cols * preset.rows }).map(() => <span />)}
                  </div>
                </div>
                <h3>{preset.name}</h3>
                <p class="preset-size">{preset.size}</p>
                <p class="preset-summary">{preset.summary}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section journal-stage" data-reveal>
        <div class="section-headline split-head">
          <h2 class="section-title">From the blog</h2>
          <a class="button-ghost" href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, '/')}>
            Browse all <Icon name="arrow-right" size={16} />
          </a>
        </div>

        <div class="journal-list">
          {
            posts.map(post => (
              <a
                class="journal-row"
                href={`${import.meta.env.BASE_URL}/blog/${post.id}/`.replace(/\/\//g, '/')}
              >
                <span class="journal-meta">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <span class="journal-main">
                  <span class="journal-title">{post.data.title}</span>
                  <span class="journal-desc">{post.data.description}</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .home-page {
    display: grid;
    gap: 0;
  }

  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.35rem;
    padding: 3.5rem 0 4.5rem;
  }

  .hero .lede {
    max-width: 46ch;
  }

  .hero .button-row {
    justify-content: center;
  }

  .hero-logo {
    width: clamp(5rem, 11vw, 7.5rem);
    height: auto;
    margin-bottom: 0.5rem;
    animation: hero-spin 8s linear infinite;
  }

  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo {
      animation: none;
    }
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.4rem;
  }

  .highlight h3 {
    margin: 0 0 0.42rem;
    font-weight: 650;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
  }

  .highlight p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .preset-stage,
  .journal-stage {
    display: grid;
    gap: 1.5rem;
  }

  .preset-lane {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .preset {
    display: grid;
    justify-items: start;
    gap: 0.3rem;
    border-radius: var(--radius-md);
    padding: 1.4rem;
    background: var(--panel);
  }

  /* Each preset previews its own grid shape, to true proportions. A fixed
     band keeps the taller boards from pushing their titles out of line. */
  .preset-preview {
    display: flex;
    align-items: flex-end;
    height: 88px;
    margin-bottom: 1.1rem;
  }

  .preset-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 5px);
    gap: 2px;
  }

  .preset-grid span {
    aspect-ratio: 1;
    border-radius: 1px;
    background: color-mix(in srgb, var(--text) 17%, transparent);
  }

  .preset h3 {
    margin: 0;
    font-weight: 650;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
  }

  .preset-size {
    margin: 0.1rem 0 0;
    color: var(--text-soft);
    font-size: 0.86rem;
    letter-spacing: 0.06em;
  }

  .preset-summary {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .section-headline.split-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .journal-list {
    display: grid;
    gap: 0.5rem;
  }

  .journal-row {
    display: grid;
    grid-template-columns: minmax(110px, 150px) 1fr;
    gap: 1.1rem;
    align-items: start;
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    transition: background 0.2s ease;
  }

  .journal-row:hover {
    background: var(--panel);
  }

  .journal-meta {
    padding-top: 0.16rem;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .journal-main {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .journal-title {
    font-weight: 650;
    font-size: 1.14rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .journal-desc {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  @media (max-width: 900px) {
    .highlight-grid {
      grid-template-columns: 1fr;
      gap: 1.9rem;
    }

    .preset-lane {
      grid-template-columns: 1fr;
    }

    .journal-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .journal-meta {
      padding-top: 0;
    }
  }
</style>
