---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import BackToTop from '../components/BackToTop.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { boardPresets, featureCards, playLink, siteConfig } from '../data/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const highlights = featureCards.slice(0, 3);
---

<Layout title={siteConfig.name} description={siteConfig.description}>
  <SiteHeader />

  <div class="page-shell">
    <main class="container home-page" data-pagefind-body>
      <section class="hero" data-reveal>
        <h1 class="display-title">
          Quick rounds,
          <span class="gradient-text">big reversals.</span>
        </h1>
        <p class="lede">A fast board game for friends. Tense until the last burst.</p>
        <div class="button-row">
          <a class="button button-play" href={playLink.href} target="_blank" rel="noreferrer">
            Play game
          </a>
          <a class="button" href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, '/')}>
            How to play
          </a>
        </div>

        <div class="hero-board" aria-hidden="true">
          <div class="mini-board">
            {
              [
                '', 'r', '', '', 'y2', '',
                'r', '', '', '', '', '',
                '', 'r2', '', '', '', '',
                '', '', 'b2', '', '', '',
                '', '', '', '', 'b', '',
                '', 'g', '', 'g', '', '',
              ].map(cell => (
                <span class:list={['mini-cell', cell && `owner-${cell[0]}`]}>
                  {cell && <i class="atom" />}
                  {cell.endsWith('2') && <i class="atom atom-2" />}
                </span>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section highlight-stage" data-reveal>
        <div class="highlight-grid">
          {
            highlights.map(feature => (
              <article class="highlight">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section preset-stage" data-reveal>
        <h2 class="section-title">Three board sizes.</h2>
        <div class="preset-lane">
          {
            boardPresets.map(preset => (
              <article class="preset">
                <p class="preset-size">{preset.size}</p>
                <h3>{preset.name}</h3>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section journal-stage" data-reveal>
        <div class="section-headline split-head">
          <h2 class="section-title">From the blog</h2>
          <a class="button-ghost" href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, '/')}>
            Browse all <ArrowRight size={16} />
          </a>
        </div>

        <div class="journal-list">
          {
            posts.map(post => (
              <a
                class="journal-row"
                href={`${import.meta.env.BASE_URL}/blog/${post.id}/`.replace(/\/\//g, '/')}
              >
                <span class="journal-meta">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <span class="journal-main">
                  <span class="journal-title">{post.data.title}</span>
                  <span class="journal-desc">{post.data.description}</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .home-page {
    display: grid;
    gap: 0;
  }

  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.35rem;
    padding: 3.5rem 0 4.5rem;
  }

  .hero .lede {
    max-width: 46ch;
  }

  .hero .button-row {
    justify-content: center;
  }

  .hero-board {
    width: min(100%, 320px);
    margin-top: 1.2rem;
  }

  .mini-board {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    width: 100%;
    aspect-ratio: 1;
  }

  .mini-cell {
    position: relative;
    border-radius: 14px;
    background: var(--panel);
    display: grid;
    place-items: center;
  }

  .mini-cell.owner-r { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-red) 55%, transparent); }
  .mini-cell.owner-b { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-blue) 55%, transparent); }
  .mini-cell.owner-g { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-green) 55%, transparent); }
  .mini-cell.owner-y { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-yellow) 55%, transparent); }

  .atom {
    width: 22%;
    height: 22%;
    border-radius: 50%;
  }

  .owner-r .atom { background: var(--player-red); }
  .owner-b .atom { background: var(--player-blue); }
  .owner-g .atom { background: var(--player-green); }
  .owner-y .atom { background: var(--player-yellow); }

  .atom-2 {
    position: absolute;
    transform: translateY(-70%);
  }

  .mini-cell .atom:first-of-type {
    transform: translateY(20%);
  }

  .mini-cell:not(:has(.atom-2)) .atom:first-of-type {
    transform: none;
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.4rem;
  }

  .highlight h3 {
    margin: 0 0 0.42rem;
    font-weight: 650;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
  }

  .highlight p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .preset-stage,
  .journal-stage {
    display: grid;
    gap: 1.5rem;
  }

  .preset-lane {
    display: flex;
    flex-wrap: wrap;
    gap: 3.2rem;
  }

  .preset-size {
    margin: 0 0 0.2rem;
    font-size: 1.9rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .preset h3 {
    margin: 0;
    font-weight: 500;
    font-size: 0.94rem;
    color: var(--text-muted);
  }

  .section-headline.split-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .journal-list {
    display: grid;
    gap: 0.5rem;
  }

  .journal-row {
    display: grid;
    grid-template-columns: minmax(110px, 150px) 1fr;
    gap: 1.1rem;
    align-items: start;
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    transition: background 0.2s ease;
  }

  .journal-row:hover {
    background: var(--panel);
  }

  .journal-meta {
    padding-top: 0.16rem;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .journal-main {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .journal-title {
    font-weight: 650;
    font-size: 1.14rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .journal-desc {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  @media (max-width: 900px) {
    .highlight-grid {
      grid-template-columns: 1fr;
      gap: 1.9rem;
    }

    .preset-lane {
      gap: 2.2rem;
    }

    .journal-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .journal-meta {
      padding-top: 0;
    }
  }
</style>
