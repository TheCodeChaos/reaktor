---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import BackToTop from '../components/BackToTop.astro';
import AuthorBadge from '../components/AuthorBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import {
  boardPresets,
  faqItems,
  featureCards,
  playLink,
  siteConfig,
} from '../data/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title={siteConfig.name} description={siteConfig.description}>
  <SiteHeader />

  <div class="page-shell">
    <main class="container home-page" data-pagefind-body>
      <section class="section hero-stage" data-reveal>
        <div class="hero-copy">
          <h1 class="display-title">
            Quick rounds,
            <span class="gradient-text">big reversals.</span>
          </h1>
          <p class="lede">
            A clean, fast board game for friends. Easy to start, tense until the last burst.
          </p>
          <div class="button-row">
            <a class="button button-play" href={playLink.href} target="_blank" rel="noreferrer">
              Play game
            </a>
            <a class="button" href={`${import.meta.env.BASE_URL}/faq`.replace(/\/\//g, '/')}>
              How to play
            </a>
            <a class="button-secondary" href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, '/')}>
              Strategy blog
            </a>
          </div>
        </div>

        <div class="hero-board" aria-hidden="true">
          <div class="mini-board">
            {
              [
                '', 'r', '', '', 'y2', '',
                'r', '', '', '', '', '',
                '', 'r2', '', '', '', '',
                '', '', 'b2', '', '', '',
                '', '', '', '', 'b', '',
                '', 'g', '', 'g', '', '',
              ].map(cell => (
                <span class:list={['mini-cell', cell && `owner-${cell[0]}`]}>
                  {cell && <i class="atom" />}
                  {cell.endsWith('2') && <i class="atom atom-2" />}
                </span>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section feature-stage" data-reveal>
        <div class="section-headline">
          <h2 class="section-title">Built to make momentum visible.</h2>
        </div>
        <div class="feature-wave section-tight">
          {
            featureCards.map((feature, index) => (
              <article class="wave-item" style={`--delay:${index * 90}ms`} data-reveal>
                <p class="wave-index">0{index + 1}</p>
                <div>
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section preset-stage" data-reveal>
        <div class="section-headline">
          <h2 class="section-title">Pick your pressure curve.</h2>
        </div>
        <div class="preset-lane section-tight">
          {
            boardPresets.map(preset => (
              <article class="preset-chip">
                <p>{preset.size}</p>
                <div>
                  <h3>{preset.name}</h3>
                  <p>{preset.summary}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section journal-stage" data-reveal>
        <div class="section-headline split-head">
          <div>
            <h2 class="section-title">From the blog</h2>
          </div>
          <a class="button-ghost" href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, '/')}>
            Browse all <ArrowRight size={16} />
          </a>
        </div>

        <div class="journal-list section-tight">
          {
            posts.map(post => (
              <article class="journal-row">
                <div class="journal-meta">
                  <FormattedDate date={post.data.pubDate} />
                </div>
                <div class="journal-main">
                  <h3>
                    <a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`.replace(/\/\//g, '/')}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p>{post.data.description}</p>
                  <div class="tag-row">
                    {post.data.authors.map(author => <AuthorBadge authorId={author as 'ayaan' | 'shravan'} />)}
                  </div>
                </div>
                <a class="journal-link" href={`${import.meta.env.BASE_URL}/blog/${post.id}/`.replace(/\/\//g, '/')}>
                  Read <ArrowRight size={16} />
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section weave-stage" data-reveal>
        <div class="section-headline">
          <div>
            <h2 class="section-title">Support, team, and answers.</h2>
          </div>
        </div>

        <div class="weave-grid section-tight">
          <article class="weave-block">
            <h3>Support</h3>
            <p>Help paths and bug reporting.</p>
            <a href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, '/')}>Open support <ArrowRight size={15} /></a>
          </article>

          <article class="weave-block">
            <h3>Developers</h3>
            <p>Who builds the game.</p>
            <a href={`${import.meta.env.BASE_URL}/developers`.replace(/\/\//g, '/')}>Meet the team <ArrowRight size={15} /></a>
          </article>

          <article class="weave-block">
            <h3>FAQ</h3>
            <p>{faqItems.length} answers about rules and gameplay.</p>
            <a href={`${import.meta.env.BASE_URL}/faq`.replace(/\/\//g, '/')}>Open FAQ <ArrowRight size={15} /></a>
          </article>
        </div>
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .home-page {
    display: grid;
    gap: 0;
  }

  .hero-stage {
    display: grid;
    order: -1;
    gap: 1.5rem;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 0.95rem;
  }

  .hero-board {
    display: grid;
    place-items: center;
  }

  .mini-board {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    width: min(100%, 380px);
    aspect-ratio: 1;
  }

  .mini-cell {
    position: relative;
    border-radius: 14px;
    background: var(--panel);
    display: grid;
    place-items: center;
  }

  .mini-cell.owner-r { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-red) 55%, transparent); }
  .mini-cell.owner-b { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-blue) 55%, transparent); }
  .mini-cell.owner-g { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-green) 55%, transparent); }
  .mini-cell.owner-y { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--player-yellow) 55%, transparent); }

  .atom {
    width: 22%;
    height: 22%;
    border-radius: 50%;
  }

  .owner-r .atom { background: var(--player-red); }
  .owner-b .atom { background: var(--player-blue); }
  .owner-g .atom { background: var(--player-green); }
  .owner-y .atom { background: var(--player-yellow); }

  .atom-2 {
    position: absolute;
    transform: translateY(-70%);
  }

  .mini-cell .atom:first-of-type {
    transform: translateY(20%);
  }

  .mini-cell:not(:has(.atom-2)) .atom:first-of-type {
    transform: none;
  }

  .section-headline {
    display: grid;
    gap: 0.5rem;
  }

  .split-head {
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.8rem;
  }

  .feature-wave {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.1rem;
  }

  .wave-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    border-top: 1px solid var(--line-soft);
    padding-top: 0.95rem;
    transition-delay: var(--delay);
  }

  .wave-index {
    margin: 0;
    font-size: 0.76rem;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-top: 0.4rem;
  }

  .wave-item h3 {
    margin: 0 0 0.35rem;
    font-weight: 700;
    font-size: 1.2rem;
  }

  .wave-item p {
    margin: 0;
    color: var(--text-muted);
  }

  .preset-lane {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .preset-chip {
    border-radius: var(--radius-md);
    background: var(--panel);
    padding: 1.25rem;
  }

  .preset-chip p {
    margin: 0 0 0.45rem;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
  }

  .preset-chip h3 {
    margin: 0 0 0.32rem;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .preset-chip div p {
    margin: 0;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .journal-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line-soft);
  }

  .journal-row {
    display: grid;
    grid-template-columns: minmax(120px, 165px) 1fr auto;
    gap: 0.9rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .journal-meta {
    padding-top: 0.35rem;
  }

  .journal-main h3 {
    margin: 0 0 0.42rem;
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    line-height: 1.15;
  }

  .journal-main p {
    margin: 0;
    color: var(--text-muted);
  }

  .journal-main .tag-row {
    margin-top: 0.75rem;
  }

  .journal-link {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    color: var(--text);
    font-weight: 550;
    padding-top: 0.36rem;
  }

  .weave-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .weave-block {
    border-radius: var(--radius-md);
    padding: 1.25rem;
    background: var(--panel);
    display: grid;
    gap: 0.42rem;
  }

  .weave-block h3 {
    margin: 0;
    font-weight: 700;
    font-size: 1.15rem;
  }

  .weave-block p {
    margin: 0;
    color: var(--text-muted);
  }

  .weave-block a {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text);
  }

  @media (min-width: 980px) {
    .hero-stage {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  @media (max-width: 979px) {
    .hero-stage {
      grid-template-areas: "board" "copy";
    }
    .hero-copy {
      grid-area: copy;
    }
    .hero-board {
      grid-area: board;
    }
  }

  @media (max-width: 980px) {
    .feature-wave,
    .preset-lane,
    .weave-grid {
      grid-template-columns: 1fr;
    }

    .split-head {
      grid-template-columns: 1fr;
    }

    .journal-row {
      grid-template-columns: 1fr;
      gap: 0.48rem;
    }

    .journal-meta,
    .journal-link {
      padding-top: 0;
    }
  }

  @media (max-width: 740px) {
    .wave-item {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .wave-index {
      padding-top: 0;
    }
  }
</style>