---
import Icon from '../components/Icon.astro';
import BackToTop from '../components/BackToTop.astro';
import FAQList from '../components/FAQList.astro';
import Giscus from '../components/Giscus.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { faqItems, siteConfig } from '../data/site';
---

<Layout title="Support" description="Answers, bug reports, and feedback for Reaktor.">
  <SiteHeader />

  <div class="page-shell">
    <main class="container support-page" data-pagefind-body>
      <section class="section support-hero" data-reveal>
        <h1 class="page-title">Support</h1>
        <a class="report-link" href={siteConfig.issuesUrl} target="_blank" rel="noreferrer">
          <Icon name="bug" size={16} /> Report a bug
        </a>
      </section>

      <section class="section faq-body" data-reveal id="faq">
        <h2 class="section-title">FAQ</h2>
        <FAQList items={faqItems} />
      </section>

      <section class="section feedback-body" data-reveal id="feedback">
        <h2 class="section-title">Feedback</h2>
        <p class="section-copy">Sign in with GitHub to comment.</p>
        <Giscus />
      </section>
    </main>
  </div>

  <BackToTop />
  <SiteFooter />
</Layout>

<style>
  .support-page {
    display: grid;
    gap: 0;
  }

  .support-hero {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-bottom: 1rem;
  }

  .report-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    border: 1.8px solid var(--outline);
    background: var(--panel);
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 550;
    transition: color 0.2s ease;
  }

  .report-link:hover {
    color: var(--text);
  }

  .faq-body,
  .feedback-body {
    display: grid;
    gap: 1.1rem;
  }

  .feedback-body :global(.giscus-wrapper) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
</style>
